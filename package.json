{
  "name": "threadline",
  "version": "0.3.0",
  "license": "MIT",
  "type": "module",
  "description": "A visual board for organizing project context — stories, comments, and code threads — with an Electron shell that keeps a real authenticated session for embedded panels.",
  "main": "electron/main.cjs",
  "bin": {
    "threadline": "./bin/launch.cjs"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "electron .",
    "test": "node --test \"src/**/*.test.js\" \"electron/**/*.test.cjs\" && npm --workspace @threadline/core test",
    "build:win": "npm run build && electron-builder --win --publish never",
    "build:mac": "npm run build && electron-builder --mac --publish never"
  },
  "dependencies": {
    "@codemirror/language": "^6.12.4",
    "@fontsource/inter": "^5.3.0",
    "@lexical/mark": "^0.48.0",
    "@lezer/highlight": "^1.2.3",
    "@mdxeditor/editor": "^4.2.1",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@threadline/vite-plugin": "0.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lexical": "^0.48.0",
    "lucide-react": "^1.33.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-resizable-panels": "^4.12.3",
    "sql.js": "^1.14.2",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.0.0",
    "electron": "^32.0.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^5.4.21"
  }
}
